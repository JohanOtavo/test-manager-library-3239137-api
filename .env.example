# Copiar a .env y rellenar. El .env real nunca se versiona (artículo IX).
APP_NAME="Manager Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Postgres 16. El motor arranca vacío: el esquema lo crean las migraciones.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=library
DB_USERNAME=library
DB_PASSWORD=
DB_SCHEMA=library

# Clave de firma del token. Cadena larga aleatoria, nunca en el repositorio.
JWT_SECRET=

# Administrador inicial: lo crea el arranque, no la base (data-model §9).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Almacenamiento de portadas en disco local.
COVERS_DIR=storage/app/covers

# Origen del frontend permitido por CORS.
CORS_ORIGIN=http://localhost:5173
